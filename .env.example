OPENROUTER_API_KEY=sk-or-...
# Models: one value each. Changing EMBED_MODEL, EMBED_INPUT_MODE, EMBED_PASSAGE_TYPE or EMBED_SQUARE_PAGES
# requires `make reembed`. Paid since 2026-10-30: Voyage costs about $1 per 1,000 pages.
EMBED_MODEL=voyageai/voyage-multimodal-3.5
# field = send input_type; prefix = "query: " / "passage:" text parts.
EMBED_INPUT_MODE=field
EMBED_QUERY_TYPE=query
EMBED_PASSAGE_TYPE=document
# Pages per embedding request. The free nvidia/nemotron-3.5-embed-8b:free needs 1 (and EMBED_SQUARE_PAGES=true,
# EMBED_PASSAGE_TYPE=passage): it answers 502 to 2+ images and to some page shapes.
EMBED_BATCH_PAGES=8
EMBED_SQUARE_PAGES=false
# Web screenshot width in px. Follows the embedder's longest_edge (1120 for Nemotron 3.5 Embed); change it with the embedding model.
WEB_VIEWPORT_WIDTH=1120
# Web slice height in px. Either change affects only web pages added afterwards: delete and add the old ones again.
WEB_SLICE_HEIGHT=1120
# About $0.0006 per question. Free alternative: nvidia/nemotron-3.5-super-vl:free (uses the 50/day free quota).
ANSWER_MODEL=meta/muse-spark-1.3-contributor
ANSWER_REASONING_EFFORT=max
ANSWER_TEMPERATURE=0.4
# Free requests per day held back for questions (only used when a :free model is configured).
OR_RESERVE_REQUESTS=10
